<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Android only returns Wi-Fi scan results to apps holding location access. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- Quick panel: Do Not Disturb and auto-rotate tiles. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Stats screen: screen time and most used apps (usage access, granted in the settings). -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Holocalls: Netrunner can become the default Phone app. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Cyberdeck lock screen: lets it appear when the screen turns off. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Contracts (calendar), timer command. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- As//ka's reminders: exact time, and set again after a reboot. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The Agenda app (same signing key) reads her reminders. -->
    <!-- Lets the deck's own apps (Scanner, Notes) open the field kit on a code: same signing key only. -->
    <permission
        android:name="dev.netrunner.permission.KIT"
        android:label="Ouvrir le kit de terrain de Netrunner"
        android:protectionLevel="signature" />
    <!-- Kit sheet → note in Notes Netrunner (its provider, same signing key). -->
    <uses-permission android:name="dev.netrunner.permission.WRITE_NOTES" />

    <permission
        android:name="dev.netrunner.permission.READ_REMINDERS"
        android:label="Lire les rappels d'As//ka"
        android:protectionLevel="signature" />
    <!-- Built-in updates from the GitHub releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Music spectrum: Android's Visualizer reads the output mix and requires these. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />

    <!-- Lets the launcher see every app that has a launcher icon. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.anthropic.claude" />
        <package android:name="dev.netrunner.notes" />
        <!-- As//ka's ears: lets the app find the speech recognizer (Android 11+). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- As//ka's voice: lets the app find the speech engine (Android 11+). -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Apps that provide home screen widgets. -->
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Netrunner">

        <!-- As//ka runs her model on the GPU when the phone exposes OpenCL. -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- As//ka's model, in its own process: running out of memory only stops her, not the launcher. -->
        <service
            android:name=".aska.AskaEngineService"
            android:exported="false"
            android:process=":aska" />

        <!-- As//ka's reminders: the alarm and the notification's buttons, reboots, and the Agenda's view. -->
        <receiver
            android:name=".aska.AskaReminderReceiver"
            android:exported="false" />
        <receiver
            android:name=".aska.AskaPetCallReceiver"
            android:exported="false" />
        <receiver
            android:name=".aska.AskaReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <provider
            android:name=".aska.AskaRemindersProvider"
            android:authorities="dev.netrunner.launcher.reminders"
            android:exported="true"
            android:readPermission="dev.netrunner.permission.READ_REMINDERS" />

        <!-- Mirrors notifications into the HUD and unlocks media session control. -->
        <service
            android:name=".notify.NetrunnerNotificationService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Holocall UI for incoming and outgoing calls (used once Netrunner is the Phone app). -->
        <service
            android:name=".call.NetrunnerInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <activity
            android:name=".call.CallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="dev.netrunner.launcher.call"
            android:turnScreenOn="true" />

        <activity
            android:name=".call.DialerActivity"
            android:exported="true"
            android:label="Holo-liaison"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="dev.netrunner.launcher.dialer">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".call.CallActionReceiver"
            android:exported="false" />

        <activity
            android:name=".lock.LockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="dev.netrunner.launcher.lock" />

        <!-- Scanner and Notes → field kit (KIT_ADD / KIT_OPEN), signature permission only. -->
        <activity
            android:name=".kit.KitLinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="dev.netrunner.permission.KIT"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="dev.netrunner.action.KIT_ADD" />
                <action android:name="dev.netrunner.action.KIT_OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- ICE limits: intrusion screen over an app whose daily time is used up. -->
        <activity
            android:name=".ui.IceActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:taskAffinity="dev.netrunner.launcher.ice" />

        <!-- Live wallpaper (also behind the lock screen). -->
        <service
            android:name=".wallpaper.BreachWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/breach_wallpaper" />
        </service>

        <!-- Quick settings tiles. -->
        <service
            android:name=".tiles.GhostTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_ghost"
            android:label="Mode furtif"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.LockTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_lock"
            android:label="Verrou cyber"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.TerminalTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_terminal"
            android:label="Terminal"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".tiles.WifiScanTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_wifi"
            android:label="Scan Wi-Fi"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Cyberdeck keyboard. Turn it on in Settings > Keyboards. -->
        <service
            android:name=".keyboard.NetrunnerKeyboardService"
            android:exported="true"
            android:label="@string/keyboard_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/netrunner_keyboard" />
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
