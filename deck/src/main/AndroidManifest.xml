<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Updates from the GitHub releases, only when asked. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Reads the launcher's faction, so every deck app follows its theme. Same signing key only. -->
    <permission
        android:name="dev.netrunner.permission.THEME"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.netrunner.permission.THEME" />

    <queries>
        <provider android:authorities="dev.netrunner.launcher.theme" />
    </queries>

    <application>
        <!-- Hands the downloaded APK to the installer. Merged into each app with its own authority. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/deck_file_paths" />
        </provider>
    </application>
</manifest>
