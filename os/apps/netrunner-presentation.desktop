[Desktop Entry]
Type=Application
Name=Présentation
GenericName=Présentation
Comment=Faire et projeter des diaporamas PowerPoint (.pptx) et OpenDocument (.odp)
Exec=netrunner-presentation %f
Icon=netrunner-presentation
Terminal=false
Categories=Office;Presentation;
MimeType=application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.ms-powerpoint;application/vnd.oasis.opendocument.presentation;
Keywords=powerpoint;diaporama;présentation;diapo;pptx;odp;
